---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;description:string;canonical?:string}
const {title,description,canonical}=Astro.props;
const url=new URL(canonical??Astro.url.pathname,'https://sems-erp.co.uk').toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={description}/><meta name="theme-color" content="#5036c9"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="SEMS-ERP"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/>
<meta name="twitter:card" content="summary"/><link rel="canonical" href={url}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<title>{title}</title>
</head>
<body><a href="#main" style="position:absolute;left:-9999px;top:5px;background:white;padding:12px;z-index:100" onfocus="this.style.left='5px'" onblur="this.style.left='-9999px'">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></body>
</html>
