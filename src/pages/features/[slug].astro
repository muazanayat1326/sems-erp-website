---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import {modules} from '../../data/modules';
import {editorial} from '../../data/editorial';
import {fieldGuides,workflowGuides,scenarios} from '../../data/refinement';
export function getStaticPaths(){return modules.map(module=>({params:{slug:module.slug},props:{module}}))}
const {module}=Astro.props;
const detail=editorial[module.slug];
const fieldGuide=fieldGuides[module.slug];
const workflowGuide=workflowGuides[module.slug];
const scenario=scenarios[module.slug];
const related=modules.filter(m=>m.slug!==module.slug).slice((Number(module.number)-1)%7,(Number(module.number)-1)%7+3);
---
<Layout title={`${module.title} | Detailed SEMS-ERP Module Guide`} description={`${module.intro} Explore the full workflow, records, outputs, practical examples and frequently asked questions.`}>
<main>
<section class="editorial-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/features/">All modules</a> / {module.title}</nav><span class="eyebrow">MODULE {module.number} / {module.eyebrow}</span><h1 class="editorial-h1">{module.title}<span class="text-teal">.</span></h1><p class="editorial-deck">{module.intro}</p><div class="actions"><a class="btn btn-primary" href="/contact/">Request a module walkthrough ↗</a><a class="btn btn-outline" href="#workflow">See the workflow ↓</a></div><div class="hero-facts"><span>Practical school operations</span><span>Role-aware access</span><span>Based on inspected product workflows</span></div></div></section>
<div class="container page-layout"><aside class="toc" aria-label="On this page"><span class="eyebrow">IN THIS GUIDE</span><a href="#overview">Overview</a><a href="#capabilities">Detailed capabilities</a><a href="#workflow">Step-by-step workflow</a><a href="#example">Practical example</a><a href="#records">Records & outcomes</a><a href="#questions">Common questions</a><a href="#related">Related modules</a><div class="toc-cta"><strong>Explore it with your team</strong><p>See the workflow in a guided product discussion.</p><a href="/contact/">Request a demo →</a></div></aside>
<div class="article-main"><section class="article-section" id="overview"><span class="eyebrow">01 / MODULE OVERVIEW</span><h2 class="editorial-h2">{detail.heading}</h2><p class="article-lead">{detail.scenario}</p><div class="editorial-quote"><span>WHY IT MATTERS</span><p>{detail.outcome}</p></div></section>
<section class="article-section" id="capabilities"><span class="eyebrow">02 / WHAT YOU CAN DO</span><h2 class="editorial-h2">A closer look at every capability.</h2><p class="section-deck">These are concrete functions represented in the inspected ERP interface—not a list of aspirational integrations.</p><div class="capability-grid">{module.features.map((feature,i)=><article class="capability-panel"><div class="capability-panel-top"><span class="capability-number">{String(i+1).padStart(2,'0')}</span><span class="capability-symbol" aria-hidden="true">{i%3===0?'↗':i%3===1?'◇':'✓'}</span></div><h3>{feature.title}</h3><p>{feature.description}</p><div class="capability-foot">PART OF THE {module.eyebrow.toUpperCase()} WORKFLOW</div></article>)}</div></section>
<section class="article-section" id="workflow"><span class="eyebrow">03 / HOW IT WORKS</span><h2 class="editorial-h2">A workflow your team can follow.</h2><p class="section-deck">{detail.flow}</p><div class="timeline">{module.workflow.map((step,i)=><div class="timeline-item"><div class="timeline-number">{String(i+1).padStart(2,'0')}</div><div><h3>{step}</h3><p>{workflowGuide[i] || 'Review the saved information and use the available controls to follow up.'}</p></div></div>)}</div></section>
<section class="article-section" id="example"><span class="eyebrow">04 / IN PRACTICE</span><h2 class="editorial-h2">See how this works in a school.</h2><p class="section-deck">A realistic operational example, showing the sequence of work and the information staff can review.</p><div class="case-study"><div class="case-label">SCHOOL WORKFLOW / EXAMPLE</div><h3>{scenario.title}</h3><p>{scenario.intro}</p><div class="case-steps">{scenario.stages.map((stage,i)=><div class="case-step"><span>{String(i+1).padStart(2,'0')}</span><div><strong>{stage.title}</strong><p>{stage.description}</p></div></div>)}</div><div class="case-result"><strong>Result for the school</strong><p>{scenario.result}</p></div></div></section>
<section class="article-section" id="records"><span class="eyebrow">05 / DATA & OUTPUTS</span><h2 class="editorial-h2">What goes in. What comes out.</h2><p class="section-deck">Understanding the records behind a workflow helps a school plan implementation and staff responsibilities.</p><div class="record-grid"><article><span>01 / INFORMATION ENTERED</span><h3>Inputs</h3><p>{detail.input}</p></article><article><span>02 / INFORMATION SAVED</span><h3>Records</h3><p>{detail.record}</p></article><article><span>03 / INFORMATION REVIEWED</span><h3>Views & outputs</h3><p>{detail.output}</p></article></div><div class="field-guide"><div><span class="eyebrow">A CLOSER LOOK AT THE RECORD</span><h3>What your team works with</h3><p>Representative fields and actions drawn from the inspected application screens. Availability depends on role and school configuration.</p></div><div class="field-pills">{fieldGuide.map(field=><span>{field}</span>)}</div></div><div class="role-band"><strong>Who uses this area?</strong><p>{module.roles}. The actual controls visible depend on account permissions and school entitlements.</p></div></section>
<section class="article-section" id="questions"><span class="eyebrow">06 / FREQUENTLY ASKED</span><h2 class="editorial-h2">Clear answers, without overpromising.</h2><div class="faq-stack">{detail.faq.map(item=><details class="faq-item"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div>{module.note&&<div class="scope-note"><strong>Scope clarification</strong><p>{module.note}</p></div>}</section>
<section class="article-section" id="related"><span class="eyebrow">07 / EXPLORE FURTHER</span><h2 class="editorial-h2">Connected school workflows.</h2><div class="related-list">{related.map(m=><a href={`/features/${m.slug}/`}><span>{m.number} / {m.eyebrow}</span><strong>{m.title}</strong><span aria-hidden="true">↗</span></a>)}</div></section></div></div>
<CTA/></main>
</Layout>
