---
import Layout from '../../layouts/Layout.astro';import CTA from '../../components/CTA.astro';
---
<Layout title="About SEMS-ERP | Smart Education Management System" description="Learn about SEMS-ERP and its approach to connected, practical school management workflows.">
<section class="page-hero"><div class="container"><span class="eyebrow">About SEMS-ERP</span><h1 class="h1">School management should feel <span class="text-indigo">connected, not complicated.</span></h1><p class="lead">SEMS-ERP — Smart Education Management System — brings important school records and daily operational workflows into one platform.</p></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Our focus</span><h2 class="h2">Practical software for the everyday work of schools.</h2><p class="lead">From admissions and student records to teaching schedules, attendance, financial collection and reporting, school teams handle a wide range of information. SEMS-ERP provides structured workspaces for these connected responsibilities.</p><p class="lead">Our goal is a clearer, more manageable school day for the people using the platform — from administrators and teachers to parents and students.</p></div><div class="mock-surface"><h3 style="font-size:1.5rem">What guides the platform</h3>{[['Clarity','Understand important school information'],['Continuity','Keep related workflows connected'],['Practicality','Support the tasks teams perform every day'],['Appropriate access','Show users relevant tools and records']].map(([a,b])=><div class="mock-row"><span class="mock-label">{a}</span><span style="font-size:.78rem;color:#766b88;text-align:right">{b}</span></div>)}</div></div></section>
<section class="section soft"><div class="container"><div class="section-head"><span class="eyebrow">Built around school operations</span><h2 class="h2">One platform, different responsibilities.</h2><p class="lead">A connected approach without treating every user or department the same.</p></div><div class="grid3"><article class="feature-card"><div class="feature-icon">◈</div><h3>School administration</h3><p>Keep institutional settings, admissions, accounts and important records organised.</p></article><article class="feature-card"><div class="feature-icon">✎</div><h3>Teaching & learning</h3><p>Coordinate classes, timetables, coursework, attendance and academic results.</p></article><article class="feature-card"><div class="feature-icon">◎</div><h3>Families & students</h3><p>Give linked users access to relevant academic and school information through dedicated portals.</p></article></div></div></section><CTA/>
</Layout>
