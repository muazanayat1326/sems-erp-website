---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Contact & Request a Demo | SEMS-ERP" description="Request a SEMS-ERP demonstration and tell us about your school's administration, academics, attendance or finance requirements.">
<section class="page-hero"><div class="container"><span class="eyebrow">Let's talk about your school</span><h1 class="h1">A better school day <span class="text-indigo">starts with a conversation.</span></h1><p class="lead">Share your requirements and we'll discuss the SEMS-ERP workflows most relevant to your school.</p></div></section>
<section class="section"><div class="container contact-grid"><div><span class="eyebrow">Get in touch</span><h2 class="h2">Tell us what your school needs.</h2><p class="lead">Whether you're reviewing student management, academic operations, attendance or fees, we'd be glad to discuss your requirements and a product demonstration.</p><div class="actions"><a class="btn btn-teal" href="https://wa.me/923111790505?text=Hello%20SEMS-ERP%2C%20I%20would%20like%20to%20request%20a%20demo%20for%20my%20school." target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗</a></div><div class="note" style="margin-top:40px"><strong>What happens next?</strong><br/>Our team can review your enquiry and contact you to discuss a demonstration. Please do not submit sensitive student information.</div></div><div class="form-card"><h2 style="font-size:1.75rem;margin:0 0 10px">Request a Demo</h2><p style="color:var(--muted);line-height:1.8;margin-bottom:26px">Complete the form and we'll get in touch about your school's requirements.</p><form id="demo-enquiry-form"><div class="field"><label for="school">School Name</label><input id="school" name="school" type="text" required minlength="2" maxlength="120" autocomplete="organization" placeholder="Your school name"/></div><div class="form-grid"><div class="field"><label for="name">Contact Person</label><input id="name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Full name"/></div><div class="field"><label for="phone">Phone Number</label><input id="phone" name="phone" type="tel" required minlength="7" maxlength="40" autocomplete="tel" placeholder="Phone number"/></div></div><div class="field"><label for="email">Email Address</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@school.com"/></div><div class="field"><label for="message">Your Requirements</label><textarea id="message" name="message" rows="5" required minlength="10" maxlength="3000" placeholder="Tell us about your school and the modules you would like to explore..."></textarea></div><div style="display:none" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"/></div><div class="cf-turnstile" data-sitekey="0x4AAAAAAFdhLdqYX4rSDKSc"></div><p style="font-size:.75rem;line-height:1.7;color:#7b7389;margin:20px 0">We use your details to respond to this enquiry. Please do not include confidential school or student records.</p><p id="enquiry-status" role="status" aria-live="polite" style="font-size:.85rem;font-weight:700"></p><button id="enquiry-submit" class="btn btn-primary" style="width:100%;margin-top:10px" type="submit">Request a Demo ↗</button></form></div></div></section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
const form=document.querySelector<HTMLFormElement>('#demo-enquiry-form');const status=document.querySelector<HTMLElement>('#enquiry-status');const button=document.querySelector<HTMLButtonElement>('#enquiry-submit');
form?.addEventListener('submit',async event=>{event.preventDefault();if(!form||!status||!button)return;const fields=new FormData(form);if(String(fields.get('website')||'').trim()){status.textContent='Unable to submit your enquiry.';return;}const token=String(fields.get('cf-turnstile-response')||'');if(!token){status.textContent='Please complete the security verification.';status.style.color='#b91c1c';return;}button.disabled=true;button.textContent='Sending...';status.textContent='Submitting your enquiry...';status.style.color='#655f77';try{const response=await fetch('https://sems-website-enquiries.noor-companion.workers.dev/api/enquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({school:fields.get('school'),name:fields.get('name'),phone:fields.get('phone'),email:fields.get('email'),message:fields.get('message'),turnstileToken:token})});const result=await response.json();if(!response.ok||!result.success)throw new Error(result.error||'Unable to submit your enquiry.');status.textContent='Thank you! Your enquiry has been submitted.';status.style.color='#087f7e';form.reset();window.turnstile?.reset();}catch(error){status.textContent=error instanceof Error?error.message:'Unable to submit your enquiry. Please try again.';status.style.color='#b91c1c';window.turnstile?.reset();}finally{button.disabled=false;button.textContent='Request a Demo ↗';}});
</script>
</Layout>
