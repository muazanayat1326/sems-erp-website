
---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact & Request a Demo | SEMS-ERP"
  description="Contact SEMS-ERP to discuss your school's management requirements and request a product demonstration."
>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3 lg:px-8">
      <a href="/" aria-label="SEMS-ERP home">
        <img
          src="/images/sems-logo.svg"
          alt="SEMS-ERP"
          class="h-16 w-auto max-w-[170px] object-contain"
          width="170"
          height="64"
        />
      </a>

      <div class="flex items-center gap-4 text-sm font-semibold sm:gap-8">
        <a href="/" class="text-slate-600 hover:text-indigo-600">Home</a>
        <a href="/features/" class="text-slate-600 hover:text-indigo-600">Features</a>
        <a href="/product-tour/" class="text-slate-600 hover:text-indigo-600">Product Tour</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="bg-gradient-to-b from-slate-50 to-white px-6 py-20 text-center">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">
          Get in Touch
        </p>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Let's Talk About Your
          <span class="block text-indigo-600">School's Needs</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          Interested in SEMS-ERP? Share your requirements and explore
          how our platform could support your school.
        </p>
      </div>
    </section>

    <section class="px-6 pb-24">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-extrabold text-slate-900">
            Let's Start a Conversation
          </h2>
          <p class="mt-5 leading-8 text-slate-600">
            Tell us about your school, the administrative challenges
            you're facing, and the features you'd like to explore.
          </p>

<div class="mt-8">
  <a
    href="https://wa.me/923111790505?text=Hello%20SEMS-ERP%2C%20I%20would%20like%20to%20request%20a%20demo%20for%20my%20school."
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-3 rounded-xl bg-green-600 px-6 py-4 text-sm font-bold text-white transition hover:bg-green-700"
  >
    <span aria-hidden="true">💬</span>
    Chat on WhatsApp
    <span aria-hidden="true">↗</span>
  </a>

  <p class="mt-3 text-sm text-slate-500">
    Chat directly with our team to discuss your school's requirements.
  </p>
</div>
          <div class="mt-8 rounded-2xl border border-indigo-100 bg-indigo-50 p-6">
            <h3 class="font-bold text-indigo-900">What happens next?</h3>
            <p class="mt-3 text-sm leading-7 text-indigo-800">
              Once you submit your enquiry, our team will be
              able to review your requirements and contact you about a demonstration.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-100 sm:p-10 lg:col-span-3">
          <h2 class="text-2xl font-extrabold text-slate-900">
            Request a Demo
          </h2>

                    <p class="mt-3 text-sm leading-7 text-slate-500">
            Complete the form and our team will contact you to discuss a demonstration.
          </p>

          <form id="demo-enquiry-form" class="mt-8 space-y-6">
            <div>
              <label for="school" class="mb-2 block text-sm font-semibold text-slate-700">School Name</label>
              <input id="school" name="school" type="text" required minlength="2" maxlength="120" autocomplete="organization" placeholder="Your school name"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900" />
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">Contact Person</label>
                <input id="name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your full name"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900" />
              </div>

              <div>
                <label for="phone" class="mb-2 block text-sm font-semibold text-slate-700">Phone Number</label>
                <input id="phone" name="phone" type="tel" required minlength="7" maxlength="40" autocomplete="tel" placeholder="Your phone number"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900" />
              </div>
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email Address</label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@school.com"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900" />
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-semibold text-slate-700">Your Requirements</label>
              <textarea id="message" name="message" rows="5" required minlength="10" maxlength="3000" placeholder="Tell us what your school needs..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900"></textarea>
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="website">Leave this field empty</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="cf-turnstile" data-sitekey="0x4AAAAAAFdhLdqYX4rSDKSc"></div>

            <p class="text-xs leading-5 text-slate-500">
              We use your information to respond to your enquiry and arrange a demonstration.
              Please do not include sensitive student information.
            </p>

            <p id="enquiry-status" role="status" aria-live="polite" class="hidden text-sm font-medium"></p>

            <button id="enquiry-submit" type="submit"
              class="w-full rounded-xl bg-indigo-600 px-6 py-4 text-sm font-bold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60">
              Request a Demo
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 py-10 text-center text-sm text-slate-500">
    © {new Date().getFullYear()} SEMS-ERP. Smart Education Management System.
  </footer>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.querySelector<HTMLFormElement>("#demo-enquiry-form");
  const status = document.querySelector<HTMLElement>("#enquiry-status");
  const button = document.querySelector<HTMLButtonElement>("#enquiry-submit");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form || !status || !button) return;

    const fields = new FormData(form);

    if (String(fields.get("website") || "").trim()) {
      status.textContent = "Unable to submit your enquiry.";
      status.className = "text-sm font-medium text-red-700";
      return;
    }

    const token = String(fields.get("cf-turnstile-response") || "");

    if (!token) {
      status.textContent = "Please complete the security verification.";
      status.className = "text-sm font-medium text-red-700";
      return;
    }

    button.disabled = true;
    button.textContent = "Sending...";
    status.textContent = "Submitting your enquiry...";
    status.className = "text-sm font-medium text-slate-600";

    try {
      const response = await fetch(
        "https://sems-website-enquiries.noor-companion.workers.dev/api/enquiry",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            school: fields.get("school"),
            name: fields.get("name"),
            phone: fields.get("phone"),
            email: fields.get("email"),
            message: fields.get("message"),
            turnstileToken: token,
          }),
        }
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Unable to submit your enquiry.");
      }

      status.textContent = "Thank you! Your enquiry has been submitted.";
      status.className = "text-sm font-medium text-green-700";

      form.reset();
      window.turnstile?.reset();
    } catch (error) {
      status.textContent =
        error instanceof Error
          ? error.message
          : "Unable to submit your enquiry. Please try again.";

      status.className = "text-sm font-medium text-red-700";
      window.turnstile?.reset();
    } finally {
      button.disabled = false;
      button.textContent = "Request a Demo";
    }
  });
</script>
</Layout>
