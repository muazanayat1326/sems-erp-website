---
import Layout from '../layouts/Layout.astro';

const modules = [
  { number: '01', icon: '🎓', title: 'Student Records & Admissions', description: 'Keep admission details, student profiles, class information, and essential academic records organized in one place.', points: ['Student profiles', 'Admissions information', 'Organized records'] },
  { number: '02', icon: '📅', title: 'Attendance Management', description: 'Maintain daily attendance records and make it easier for authorized school teams to review attendance information.', points: ['Daily attendance', 'Class-wise records', 'Attendance visibility'] },
  { number: '03', icon: '💳', title: 'Fees & Finance', description: 'Bring fee records, payments, and related administrative tasks into a more structured school workflow.', points: ['Fee records', 'Payment tracking', 'Financial organization'] },
  { number: '04', icon: '📚', title: 'Academics & Classes', description: 'Coordinate classes, academic information, and the day-to-day records that support teaching and school administration.', points: ['Class organization', 'Academic records', 'School workflows'] },
  { number: '05', icon: '📝', title: 'Examinations & Results', description: 'Keep examination-related information and student results together for easier administration and review.', points: ['Exam records', 'Result management', 'Academic oversight'] },
  { number: '06', icon: '👥', title: 'Staff Administration', description: 'Organize important staff information alongside the other records your school needs to operate.', points: ['Staff records', 'Administrative access', 'Connected information'] },
  { number: '07', icon: '📊', title: 'Reports & Insights', description: 'Review school information through reports that help administrators understand operations and plan next steps.', points: ['Operational reports', 'Clearer visibility', 'Informed decisions'] },
  { number: '08', icon: '🏫', title: 'School Administration', description: 'Reduce the need to jump between separate files and tools by keeping key school processes connected.', points: ['Centralized workflows', 'Consistent records', 'Simpler coordination'] },
];

const benefits = [
  { number: '01', title: 'Less scattered information', description: 'Keep important school records in a more consistent, accessible structure instead of relying on disconnected files.' },
  { number: '02', title: 'A clearer daily workflow', description: 'Give school teams an organized place to work with the information relevant to their responsibilities.' },
  { number: '03', title: 'Better administrative oversight', description: 'Bring academic, attendance, and financial information into a connected view of school operations.' },
  { number: '04', title: 'More time for meaningful work', description: 'Spend less effort locating records and more attention on students, staff, and school priorities.' },
];

const audiences = [
  { icon: '🏫', title: 'School owners & leadership', description: 'Get a clearer picture of the school’s administrative and academic operations.' },
  { icon: '📋', title: 'Principals & administrators', description: 'Coordinate daily processes, student records, attendance, and essential information.' },
  { icon: '📖', title: 'Academic teams', description: 'Work with class, examination, and result-related records in an organized environment.' },
  { icon: '💼', title: 'Accounts & office staff', description: 'Manage fee-related records and routine school administration with greater clarity.' },
];

const steps = [
  { number: '01', title: 'Tell us about your school', description: 'Share your school’s requirements using our enquiry form or WhatsApp contact link.' },
  { number: '02', title: 'See a guided demonstration', description: 'Explore the relevant SEMS-ERP modules and discuss how they fit your existing workflows.' },
  { number: '03', title: 'Discuss your next steps', description: 'Ask about suitability, setup requirements, availability, and the implementation process before making a decision.' },
];

const faqs = [
  { question: 'What is SEMS-ERP?', answer: 'SEMS-ERP is a school management platform designed to help organize administration, student information, attendance, academics, fees, and reporting.' },
  { question: 'Can I see SEMS-ERP before deciding?', answer: 'Yes. Use the Request a Demo button to send an enquiry. You can tell us about your school and the areas you would like to explore.' },
  { question: 'Which school processes does it cover?', answer: 'The platform covers key areas such as student records, attendance, fees, academics, examinations, staff information, and reporting. We can discuss the exact workflows relevant to your school during a demo.' },
  { question: 'Is the dashboard shown on this website a real school’s data?', answer: 'No. The dashboard image is an illustrative product concept containing sample data. Actual SEMS-ERP screens and available functionality may differ.' },
  { question: 'How can I find out about pricing and setup?', answer: 'Contact us with your school’s requirements. We can discuss the appropriate next steps, including pricing and setup details, directly with you.' },
  { question: 'How do I contact the SEMS-ERP team?', answer: 'Use the Contact page to submit an enquiry, or choose the WhatsApp option to start a conversation.' },
];

const whatsappUrl = 'https://wa.me/923111790505?text=Hello%20SEMS-ERP%2C%20I%20would%20like%20to%20request%20a%20demo%20for%20my%20school.';
---

<Layout
  title="SEMS-ERP | School Management Software for Smarter Administration"
  description="Explore SEMS-ERP school management software for student records, attendance, fees, academics, examinations, administration and reporting. Request a demo."
>
  <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-xl">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-6 lg:px-8" aria-label="Main navigation">
      <a href="/" class="shrink-0" aria-label="SEMS-ERP home">
        <img src="/images/sems-logo.svg" alt="SEMS-ERP — Smart Education Management System" class="h-14 w-auto max-w-[155px] object-contain sm:h-16" width="170" height="64" />
      </a>
      <div class="hidden items-center gap-7 text-sm font-semibold text-slate-600 lg:flex">
        <a href="#features" class="transition hover:text-indigo-600">Features</a>
        <a href="#why-sems" class="transition hover:text-indigo-600">Why SEMS-ERP</a>
        <a href="#who-its-for" class="transition hover:text-indigo-600">Who It's For</a>
        <a href="/product-tour/" class="transition hover:text-indigo-600">Product Tour</a>
        <a href="#faq" class="transition hover:text-indigo-600">FAQs</a>
        <a href="/contact/" class="transition hover:text-indigo-600">Contact</a>
      </div>
      <a href="/contact/" class="hidden rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 lg:inline-flex">Request a Demo <span aria-hidden="true" class="ml-2">↗</span></a>
      <details class="group relative ml-auto lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-center rounded-xl border border-slate-200 bg-white p-3 text-slate-700 marker:hidden [&::-webkit-details-marker]:hidden" aria-label="Toggle navigation menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="absolute right-0 top-full mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl">
          <div class="flex flex-col gap-1 text-sm font-semibold text-slate-700">
            <a href="#features" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Features</a>
            <a href="#why-sems" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Why SEMS-ERP</a>
            <a href="#who-its-for" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Who It's For</a>
            <a href="/product-tour/" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Product Tour</a>
            <a href="#faq" class="rounded-lg px-4 py-3 hover:bg-indigo-50">FAQs</a>
            <a href="/contact/" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Contact</a>
            <a href="/contact/" class="mt-2 rounded-xl bg-indigo-600 px-4 py-3 text-center text-white hover:bg-indigo-700">Request a Demo</a>
          </div>
        </div>
      </details>
    </nav>
  </header>

  <main>
    <section class="relative overflow-hidden bg-gradient-to-b from-indigo-50/80 via-slate-50 to-white">
      <div class="pointer-events-none absolute -right-32 top-20 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"></div>
      <div class="pointer-events-none absolute -left-32 bottom-20 h-80 w-80 rounded-full bg-cyan-100/70 blur-3xl"></div>
      <div class="relative mx-auto max-w-7xl px-5 pb-20 pt-20 sm:px-6 lg:px-8 lg:pb-24 lg:pt-28">
        <div class="mx-auto max-w-4xl text-center">
          <p class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-indigo-700 shadow-sm"><span class="h-2 w-2 rounded-full bg-cyan-500"></span> Smart Education Management System</p>
          <h1 class="mt-7 text-4xl font-extrabold leading-[1.12] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">Run Your School with <span class="text-indigo-600">Greater Clarity.</span><span class="mt-2 block">Manage More in One Place.</span></h1>
          <p class="mx-auto mt-7 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">From student admissions and attendance to academics, fee records, and reporting, SEMS-ERP brings essential school operations into one organized management platform.</p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <a href="/contact/" class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-7 py-4 text-sm font-extrabold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-700">Request a Demo <span class="ml-2" aria-hidden="true">→</span></a>
            <a href="#features" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-7 py-4 text-sm font-extrabold text-slate-800 transition hover:border-indigo-300 hover:text-indigo-700">Explore Features</a>
          </div>
          <p class="mt-5 text-sm text-slate-500">Explore the platform • Discuss your school's needs • Ask questions before deciding</p>
        </div>
        <div id="preview" class="mx-auto mt-16 max-w-6xl scroll-mt-28 rounded-3xl border border-slate-200 bg-white p-2 shadow-2xl shadow-slate-200/80 sm:p-5">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-2 pt-2 sm:px-3"><div><p class="text-sm font-extrabold text-slate-900 sm:text-base">A closer look at school management</p><p class="text-xs text-slate-500">Illustrative SEMS-ERP dashboard preview</p></div><a href="/product-tour/" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">View product tour →</a></div>
          <img src="/images/product/dashboard-preview.png" alt="Illustrative SEMS-ERP school administration dashboard showing sample student, staff, fee and attendance information" class="block h-auto w-full rounded-2xl border border-slate-100" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <p class="mt-4 text-center text-xs leading-5 text-slate-500">Illustrative product concept using sample data. Actual SEMS-ERP screens and features may differ.</p>
      </div>
    </section>

    <section class="border-y border-slate-100 bg-white py-8" aria-label="School management focus areas"><div class="mx-auto grid max-w-7xl gap-5 px-5 text-center sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8"><p class="text-sm font-bold text-slate-700">✓ Student & admission records</p><p class="text-sm font-bold text-slate-700">✓ Attendance & academics</p><p class="text-sm font-bold text-slate-700">✓ Fees & school administration</p><p class="text-sm font-bold text-slate-700">✓ Reports & oversight</p></div></section>

    <section id="features" class="scroll-mt-24 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-600">Explore the platform</p><h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">The Essential Parts of Your School, Connected</h2><p class="mt-5 text-lg leading-8 text-slate-600">Explore how SEMS-ERP is designed to support the records and workflows that school teams manage every day.</p></div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {modules.map((module) => (<article class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-xl hover:shadow-indigo-100/50"><div class="flex items-center justify-between"><span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-2xl" aria-hidden="true">{module.icon}</span><span class="text-xs font-extrabold tracking-wider text-slate-300">{module.number}</span></div><h3 class="mt-6 text-lg font-extrabold leading-7 text-slate-950">{module.title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{module.description}</p><ul class="mt-5 space-y-2 border-t border-slate-100 pt-4">{module.points.map((point) => (<li class="flex items-start gap-2 text-xs font-semibold text-slate-600"><span class="mt-0.5 text-indigo-600" aria-hidden="true">✓</span>{point}</li>))}</ul></article>))}
        </div>
        <div class="mt-10 text-center"><a href="/features/" class="inline-flex rounded-xl border border-indigo-200 bg-indigo-50 px-6 py-3 text-sm font-extrabold text-indigo-700 transition hover:bg-indigo-100">Explore the Features Page <span class="ml-2" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section id="why-sems" class="scroll-mt-24 bg-slate-50 py-20 sm:py-24"><div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8"><div><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-600">Why SEMS-ERP</p><h2 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl">Less Time Chasing Records. <span class="text-indigo-600">More Time Running Your School.</span></h2><p class="mt-6 text-base leading-8 text-slate-600">School administration involves hundreds of details. When student information, attendance, academic records, and fees live in different places, everyday work becomes harder to coordinate.</p><p class="mt-4 text-base leading-8 text-slate-600">SEMS-ERP is designed to bring those processes together in a more consistent environment, giving your team a clearer way to manage school operations.</p><a href="/contact/" class="mt-7 inline-flex font-extrabold text-indigo-600 hover:text-indigo-800">Discuss your school's needs <span class="ml-2" aria-hidden="true">→</span></a></div><div class="grid gap-4 sm:grid-cols-2">{benefits.map((benefit) => (<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><span class="text-3xl font-extrabold text-indigo-200">{benefit.number}</span><h3 class="mt-5 text-base font-extrabold text-slate-950">{benefit.title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{benefit.description}</p></article>))}</div></div></section>

    <section id="who-its-for" class="scroll-mt-24 py-20 sm:py-24"><div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8"><div class="mx-auto max-w-3xl text-center"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-600">Built around school operations</p><h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">Useful Information for the People Who Run Your School</h2><p class="mt-5 text-lg leading-8 text-slate-600">Different teams need different information. SEMS-ERP brings important school workflows into a connected platform.</p></div><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{audiences.map((audience) => (<article class="rounded-2xl border border-slate-200 bg-white p-7"><span class="text-3xl" aria-hidden="true">{audience.icon}</span><h3 class="mt-5 text-lg font-extrabold text-slate-950">{audience.title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{audience.description}</p></article>))}</div></div></section>

    <section class="bg-gradient-to-br from-indigo-950 via-indigo-900 to-indigo-700 py-20 text-white sm:py-24"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 sm:px-6 lg:grid-cols-2 lg:px-8"><div><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-200">See the platform in context</p><h2 class="mt-4 text-3xl font-extrabold leading-tight sm:text-4xl">Explore the Product Before You Make a Decision</h2><p class="mt-5 max-w-xl text-base leading-8 text-indigo-100">Get familiar with the dashboard concept, explore the feature areas, and tell us which school processes matter most to you. A guided demo is the best way to discuss your specific requirements.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/product-tour/" class="rounded-xl bg-white px-6 py-3 text-sm font-extrabold text-indigo-800 transition hover:bg-indigo-50">View Product Tour →</a><a href="/contact/" class="rounded-xl border border-white/40 px-6 py-3 text-sm font-extrabold text-white transition hover:bg-white/10">Request a Demo</a></div></div><div class="rounded-3xl border border-white/20 bg-white/10 p-6 backdrop-blur-sm sm:p-8"><p class="text-sm font-extrabold uppercase tracking-wider text-indigo-200">What you can explore</p><ul class="mt-6 space-y-5">{['How student and admission information is organized','How attendance and academic records fit into daily work','How fee-related records and reporting are presented','Which workflows match your school’s requirements'].map((item) => (<li class="flex items-start gap-3 text-sm leading-7 text-white"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 font-extrabold" aria-hidden="true">✓</span>{item}</li>))}</ul></div></div></section>

    <section id="how-it-works" class="scroll-mt-24 py-20 sm:py-24"><div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8"><div class="mx-auto max-w-3xl text-center"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-600">Getting started</p><h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">A Simple Way to Explore SEMS-ERP</h2><p class="mt-5 text-lg leading-8 text-slate-600">Start with a conversation about your school and the challenges you want to solve.</p></div><div class="mt-12 grid gap-6 md:grid-cols-3">{steps.map((step) => (<article class="relative rounded-2xl border border-slate-200 bg-slate-50 p-8"><span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-600 text-base font-extrabold text-white">{step.number}</span><h3 class="mt-6 text-xl font-extrabold text-slate-950">{step.title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{step.description}</p></article>))}</div></div></section>

    <section id="faq" class="scroll-mt-24 bg-slate-50 py-20 sm:py-24"><div class="mx-auto max-w-4xl px-5 sm:px-6 lg:px-8"><div class="text-center"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-600">Frequently asked questions</p><h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">Answers Before You Get Started</h2><p class="mt-5 text-base leading-8 text-slate-600">Here are a few common questions about SEMS-ERP and the demo process.</p></div><div class="mt-10 space-y-3">{faqs.map((faq) => (<details class="group rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-extrabold text-slate-900 marker:hidden [&::-webkit-details-marker]:hidden"><span>{faq.question}</span><span class="shrink-0 text-2xl font-normal text-indigo-600 transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-4 max-w-3xl border-t border-slate-100 pt-4 text-sm leading-7 text-slate-600">{faq.answer}</p></details>))}</div></div></section>

    <section id="contact" class="scroll-mt-24 px-5 py-20 sm:px-6 sm:py-24"><div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-700 px-6 py-14 text-center text-white shadow-2xl shadow-indigo-200 sm:px-14 sm:py-20"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-indigo-100">Take the next step</p><h2 class="mx-auto mt-5 max-w-3xl text-3xl font-extrabold leading-tight sm:text-4xl">Ready to See How SEMS-ERP Could Work for Your School?</h2><p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-indigo-100">Tell us about your school and the features you're interested in. Our enquiry form is live and ready for your demo request.</p><div class="mt-9 flex flex-wrap justify-center gap-3"><a href="/contact/" class="inline-flex justify-center rounded-xl bg-white px-7 py-4 text-sm font-extrabold text-indigo-700 transition hover:bg-indigo-50">Request a Demo →</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center rounded-xl border border-white/50 px-7 py-4 text-sm font-extrabold text-white transition hover:bg-white/10">Chat on WhatsApp ↗</a></div><p class="mt-6 text-xs text-indigo-100">No public pricing or implementation commitments are implied; please contact us for details.</p></div></section>
  </main>

  <footer class="border-t border-slate-200 bg-slate-950 py-14 text-slate-300"><div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-6 md:grid-cols-3 lg:px-8"><div><img src="/images/sems-logo.svg" alt="SEMS-ERP" class="h-16 w-auto rounded-lg bg-white p-2" width="170" height="64" loading="lazy" /><p class="mt-5 max-w-xs text-sm leading-7 text-slate-400">Smart Education Management System. Helping schools organize essential administrative and academic workflows.</p></div><div><h2 class="text-sm font-extrabold uppercase tracking-wider text-white">Explore</h2><div class="mt-5 grid grid-cols-2 gap-3 text-sm"><a href="/features/" class="hover:text-white">Features</a><a href="/product-tour/" class="hover:text-white">Product Tour</a><a href="#why-sems" class="hover:text-white">Why SEMS-ERP</a><a href="#faq" class="hover:text-white">FAQs</a><a href="#who-its-for" class="hover:text-white">Who It's For</a><a href="/contact/" class="hover:text-white">Contact</a></div></div><div><h2 class="text-sm font-extrabold uppercase tracking-wider text-white">Let's talk about your school</h2><p class="mt-5 text-sm leading-7 text-slate-400">Questions about the platform, demonstrations, or suitability for your school? Get in touch.</p><div class="mt-5 flex flex-wrap gap-3"><a href="/contact/" class="rounded-lg bg-indigo-600 px-4 py-3 text-xs font-extrabold text-white hover:bg-indigo-500">Send an Enquiry</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-slate-600 px-4 py-3 text-xs font-extrabold text-white hover:border-slate-300">WhatsApp ↗</a></div></div></div><div class="mx-auto mt-12 flex max-w-7xl flex-col justify-between gap-3 border-t border-slate-800 px-5 pt-6 text-xs text-slate-500 sm:flex-row sm:px-6 lg:px-8"><p>© {new Date().getFullYear()} SEMS-ERP. All rights reserved.</p><p>Smart Education Management System</p></div></footer>
</Layout>
