
---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    icon: '🎓',
    title: 'Student Management',
    description: 'Keep student profiles, admissions, and academic records organized in one place.',
  },
  {
    icon: '📅',
    title: 'Attendance Tracking',
    description: 'Simplify daily attendance and keep essential records accessible.',
  },
  {
    icon: '💳',
    title: 'Fee Management',
    description: 'Manage school fees, payment records, and financial workflows.',
  },
  {
    icon: '📚',
    title: 'Academic Management',
    description: 'Coordinate classes, examinations, results, and academic activities.',
  },
  {
    icon: '📊',
    title: 'Reports & Insights',
    description: 'Turn school information into clear, actionable reports.',
  },
  {
    icon: '🏫',
    title: 'School Administration',
    description: 'Bring important administrative processes into one connected system.',
  },
];
---

<Layout
  title="SEMS-ERP | Smart School Management Software"
  description="Discover SEMS-ERP, a modern school management system designed to simplify administration, academics, attendance, fees, and reporting."
>
  
<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3 lg:px-8"
    aria-label="Main navigation"
  >
    <a href="/" class="shrink-0" aria-label="SEMS-ERP home">
      <img
        src="/images/sems-logo.svg"
        alt="SEMS-ERP — Smart Education Management System"
        class="h-16 w-auto max-w-[170px] object-contain"
        width="170"
        height="64"
      />
    </a>

    <div class="hidden items-center gap-8 text-sm font-semibold text-slate-600 md:flex">
      <a href="/features/" class="transition hover:text-indigo-600">Features</a>
      <a href="#why-sems" class="transition hover:text-indigo-600">Why SEMS-ERP</a>
      <a href="/product-tour/" class="transition hover:text-indigo-600">Product Tour</a>
      <a href="/contact/" class="transition hover:text-indigo-600">Contact</a>
    </div>

    <a
      href="/contact/"
      class="hidden rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700 md:inline-flex"
    >
      Request a Demo
    </a>

    <details class="group relative ml-auto md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-xl border border-slate-200 p-3 text-slate-700 marker:hidden [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>

      <div
        class="absolute right-0 top-full mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl"
      >
        <div class="flex flex-col gap-1 text-sm font-semibold text-slate-700">
          <a href="#features" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Features</a>
          <a href="#why-sems" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Why SEMS-ERP</a>
          <a href="/product-tour/" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Product Tour</a>
          <a href="/contact/" class="rounded-lg px-4 py-3 hover:bg-indigo-50">Contact</a>
          <a
            href="/contact/"
            class="mt-2 rounded-xl bg-indigo-600 px-4 py-3 text-center text-white hover:bg-indigo-700"
          >
            Request a Demo
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>


  <main>
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
      <div class="pointer-events-none absolute -right-40 top-0 h-96 w-96 rounded-full bg-indigo-100/70 blur-3xl"></div>
      <div class="pointer-events-none absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-cyan-100/60 blur-3xl"></div>

      <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-20 lg:px-8 lg:pb-28 lg:pt-28">
        <div class="mx-auto max-w-4xl text-center">
          <span class="inline-flex items-center rounded-full border border-indigo-100 bg-indigo-50 px-4 py-2 text-xs font-bold tracking-wide text-indigo-700">
            A SMARTER WAY TO MANAGE YOUR SCHOOL
          </span>

          <h1 class="mt-8 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Everything Your School Needs.
            <span class="block text-indigo-600">One Powerful Platform.</span>
          </h1>

          <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-slate-600">
            Simplify school administration, manage academics, track attendance,
            organize fees, and access essential information with SEMS-ERP.
          </p>

          <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
            <a href="/contact/" class="rounded-xl bg-indigo-600 px-7 py-4 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700">
              Request a Demo →
            </a>
            <a href="#features" class="rounded-xl border border-slate-200 bg-white px-7 py-4 text-sm font-bold text-slate-700 transition hover:border-indigo-200 hover:text-indigo-600">
              Explore Features
            </a>
          </div>
        </div>

        
        <div
          id="preview"
          class="mx-auto mt-16 max-w-6xl scroll-mt-28 rounded-3xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-200/80 sm:p-5"
        >
          <img
            src="/images/product/dashboard-preview.png"
            alt="Illustrative SEMS-ERP school administration dashboard with sample data"
            class="block h-auto w-full rounded-2xl"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        </div>

        <p class="mt-4 text-center text-xs text-slate-500">
          Illustrative product concept with sample data.
          Actual SEMS-ERP screens may differ.
        </p>
      </div>
    </section>

    <section id="features" class="scroll-mt-24 py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Core Capabilities</p>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Built for the Way Schools Work
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            Bring everyday school operations together in one organized, easy-to-navigate system.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {features.map((feature) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-8 transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-xl hover:shadow-slate-100">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-2xl">
                {feature.icon}
              </div>
              <h3 class="mt-6 text-lg font-extrabold text-slate-900">{feature.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="why-sems" class="scroll-mt-24 bg-slate-50 py-24">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-2 lg:px-8">
        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Why SEMS-ERP</p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight text-slate-900 sm:text-4xl">
            Less Administrative Complexity. More Time for Education.
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate-600">
            School teams shouldn't have to switch between disconnected spreadsheets,
            paper records, and separate tools to get their work done.
          </p>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            SEMS-ERP is designed to bring key school processes together,
            helping teams stay organized and access information efficiently.
          </p>
          <a href="/contact/" class="mt-8 inline-flex font-bold text-indigo-600 hover:text-indigo-800">
            Learn how SEMS-ERP can help →
          </a>
        </div>

        <div class="grid grid-cols-2 gap-4">
          {[
            ['01', 'One Connected System'],
            ['02', 'Organized School Records'],
            ['03', 'Simpler Daily Workflows'],
            ['04', 'Clearer School Insights'],
          ].map(([number, title]) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <p class="text-3xl font-extrabold text-indigo-200">{number}</p>
              <h3 class="mt-8 font-bold text-slate-900">{title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 py-24">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <div class="rounded-3xl bg-indigo-600 px-7 py-16 text-white sm:px-16">
          <p class="text-sm font-bold uppercase tracking-widest text-indigo-200">Discover SEMS-ERP</p>
          <h2 class="mt-5 text-3xl font-extrabold sm:text-4xl">
            Ready to Modernize Your School?
          </h2>
          <p class="mx-auto mt-5 max-w-xl leading-8 text-indigo-100">
            See how SEMS-ERP can support your school's daily operations.
            Our demo-request form is coming soon.
          </p>
          <a href="#features" class="mt-8 inline-flex rounded-xl bg-white px-7 py-4 text-sm font-bold text-indigo-700 transition hover:bg-indigo-50">
            Explore What SEMS-ERP Offers
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white py-10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 px-6 text-center md:flex-row lg:px-8">
      <p class="font-extrabold text-slate-900">SEMS-ERP</p>
      <p class="text-sm text-slate-500">Smart Education Management System</p>
      <p class="text-sm text-slate-500">© {new Date().getFullYear()} SEMS-ERP</p>
    </div>
  </footer>
</Layout>



